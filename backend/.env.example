# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cote_timetabling
# For production use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cote_timetabling?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# AI API Keys - Gemini 1.5 Flash (Multiple keys for fallback redundancy)
GEMINI_API_KEY_1=your-gemini-api-key-1-here
GEMINI_API_KEY_2=your-gemini-api-key-2-here
GEMINI_API_KEY_3=your-gemini-api-key-3-here
GEMINI_API_KEY_4=your-gemini-api-key-4-here
GEMINI_API_KEY_5=your-gemini-api-key-5-here

# Legacy AI API Keys (optional)
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# CORS
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
# Sender shown to recipients (defaults to EMAIL_USER)
EMAIL_FROM=technotabler@timetable.cebutech.digital
EMAIL_FROM_NAME=CTU Daanbantayan Timetabling
# EMAIL_REPLY_TO=
# Or send through an SMTP host authorised for the From domain, e.g. Resend:
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_SMTP_USER=resend
# EMAIL_PASSWORD=re_your_resend_api_key
# Timetable solver. "builtin" uses the JavaScript solver only (for Node-only hosts
# such as Pterodactyl, where Python/OR-Tools is not installed). Leave unset to
# try OR-Tools first and fall back automatically.
# SCHEDULER_ENGINE=builtin
